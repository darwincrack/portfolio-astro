---

import '../styles/main.css';
import 'bootstrap/dist/css/bootstrap.css';

// Poppins local, solo el subconjunto latino (cubre á, é, ñ, ¿, ¡)
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';


// Agregar CSS para los temas
const darkThemeColors = {
  primary: '#0f172a',    // Dark blue
  secondary: '#1e293b',  // Slightly lighter blue
  text: '#f8fafc',      // Light gray
  accent: '#0ea5e9',    // Sky blue
  gradient1: '#0ea5e9', // Sky blue
  gradient2: '#2563eb', // Blue
  gradient3: '#4f46e5', // Indigo
};

const lightThemeColors = {
  primary: '#f8fafc',    // Light gray
  secondary: '#f1f5f9',  // Slightly darker gray
  text: '#0f172a',      // Dark blue
  accent: '#0ea5e9',    // Sky blue
  gradient1: '#0ea5e9', // Sky blue
  gradient2: '#2563eb', // Blue
  gradient3: '#4f46e5', // Indigo
};

const defaultTitle = 'Desarrollo de software y web en Venezuela | Darwin Cedeño';
const defaultDescription = 'Desarrollo de software, páginas web, sistemas y apps a medida en Venezuela. Sin intermediarios, respuesta en menos de 24 horas y +300 proyectos entregados.';

const areaServed = [
  { "@type": "Country", "name": "Venezuela" },
  { "@type": "Country", "name": "España" },
  { "@type": "Place", "name": "Latinoamérica" }
];

const { 
  title = defaultTitle, 
  description = defaultDescription,
  image = 'https://darwincd.com/og-default.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Darwin Cedeño',
  section
} = Astro.props;

// Construir URL canónica
const siteUrl = 'https://darwincd.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogUrl = canonicalUrl;

// Función para optimizar títulos (50-60 caracteres recomendado)
function optimizeTitle(title: string, maxLength: number = 60): string {
  if (title.length <= maxLength) return title;
  // Truncar en el último espacio antes del límite para evitar cortar palabras
  const truncated = title.substring(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  return lastSpace > 0 ? truncated.substring(0, lastSpace) + '...' : truncated + '...';
}

const optimizedTitle = optimizeTitle(title);

import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ContactMenu from '../components/ContactMenu.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { GOOGLE_PROFILE_URL } from '../data/contact';

---

<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Aplicar el tema guardado antes de pintar, para que no parpadee
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        }
      } catch (e) {}
    </script>
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    
    {/* Preconnect solo a orígenes críticos (analytics) */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    {/* Favicon. Subir ?v= al cambiar el logo: Cloudflare y los navegadores guardan estos archivos mucho tiempo */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    
    {/* URL Canónica */}
    <link rel="canonical" href={canonicalUrl} />
    
    <title>{optimizedTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Darwin Cedeño">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
    
    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type}>
    <meta property="og:url" content={ogUrl}>
    <meta property="og:title" content={optimizedTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content="Darwin Cedeño" />
    
    {/* Twitter Card */}
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={ogUrl}>
    <meta property="twitter:title" content={optimizedTitle}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content={image}>
    
    {/* Meta tags para artículos (si aplica) */}
    {type === 'article' && publishedTime && (
      <>
        <meta property="article:published_time" content={publishedTime} />
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content={author} />
        {section && <meta property="article:section" content={section} />}
      </>
    )}

    {/* Schema.org - WebSite */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Darwin Cedeño",
      "url": "https://darwincd.com",
      "description": "Desarrollador web freelance en Venezuela. Webs, sistemas y aplicaciones móviles a medida para negocios en Venezuela, Latinoamérica y España.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://darwincd.com/blog/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />
    
    {/* Schema.org - Person */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Darwin Cedeño",
      "url": "https://darwincd.com",
      "jobTitle": "Desarrollador Web Full Stack",
      "description": "Desarrollador web freelance en Venezuela. Webs, sistemas y aplicaciones móviles a medida para negocios en Venezuela, Latinoamérica y España.",
      "sameAs": [
        "https://github.com/darwincrack/",
        "https://www.linkedin.com/in/darwincrack/",
        "https://www.instagram.com/darwinc.dev/",
        GOOGLE_PROFILE_URL
      ],
      "knowsAbout": [
        "Desarrollo Web",
        "PHP",
        "JavaScript",
        "WordPress",
        "Laravel",
        "React",
        "Aplicaciones móviles",
        "React Native",
        "Node.js",
        "MySQL",
        "SEO"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "VE"
      }
    })} />

    {/* Schema.org - Organization (para SEO y rich results) */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Darwin Cedeño",
      "url": "https://darwincd.com",
      "logo": "https://darwincd.com/logodc.jpg?v=2",
      "description": "Desarrollador web freelance en Venezuela. Webs, sistemas y aplicaciones móviles a medida para negocios en Venezuela, Latinoamérica y España.",
      "sameAs": [
        "https://github.com/darwincrack/",
        "https://www.linkedin.com/in/darwincrack/",
        "https://www.instagram.com/darwinc.dev/",
        GOOGLE_PROFILE_URL
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contacto@darwincd.com",
        "contactType": "customer service",
        "areaServed": areaServed
      }
    })} />

    <style is:global>
      /* Skip link (accesibilidad) */
      .skip-link {
        position: absolute;
        top: -100px;
        left: 1rem;
        z-index: 10000;
        padding: 0.75rem 1.25rem;
        background: var(--gradient-2);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0.5rem;
        transition: top 0.2s ease;
      }
      .skip-link:focus {
        top: 1rem;
        outline: 2px solid #0ea5e9;
        outline-offset: 2px;
      }

      /* Focus visible (accesibilidad teclado) */
      :focus { outline: none; }
      :focus-visible {
        outline: 2px solid #0ea5e9;
        outline-offset: 2px;
      }

      /* Respetar preferencia de movimiento reducido */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        html { scroll-behavior: auto; }
      }

      :root[data-theme="light"] {
        --primary-bg: #f8fafc;
        --secondary-bg: #f1f5f9;
        --text: #0f172a;
        --gradient-1: #0ea5e9;
        --gradient-2: #2563eb;
        --gradient-3: #4f46e5;
      }
      
      :root[data-theme="dark"] {
        --primary-bg: #0f172a;
        --secondary-bg: #1e293b;
        --text: #f8fafc;
        --gradient-1: #0ea5e9;
        --gradient-2: #2563eb;
        --gradient-3: #4f46e5;
      }

      body {
        background-color: var(--primary-bg);
        color: var(--text);
      }

      /* Forzar estilos sobre Bootstrap */
      .bg-white {
        background-color: var(--primary-bg) !important;
      }

      .navbar {
        background-color: var(--secondary-bg) !important;
      }
    </style>
    <style is:global>
      :root {
        --font-primary: 'Poppins', sans-serif;
      }
      
      body {
        font-family: var(--font-primary);
      }
    </style>


<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-320P4MZGS0"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  // Tráfico propio: ?interno=1 marca este navegador, ?interno=0 lo desmarca.
  // Se usa en lugar de un filtro por IP porque la IP cambia con la VPN.
  var internalTraffic = false;
  try {
    var interno = new URLSearchParams(location.search).get('interno');
    if (interno === '1') localStorage.setItem('dc_internal', '1');
    if (interno === '0') localStorage.removeItem('dc_internal');
    internalTraffic = localStorage.getItem('dc_internal') === '1';
  } catch (e) {}

  gtag('config', 'G-320P4MZGS0', internalTraffic ? { traffic_type: 'internal' } : {});

  // Registrar clics en los canales de contacto como eventos de conversión
  document.addEventListener('click', function (event) {
    var link = event.target.closest && event.target.closest('a[href]');
    if (!link) return;
    var href = link.getAttribute('href');
    // data-channel distingue el origen, p. ej. el resumen que arma el asistente
    var channel = link.dataset.channel ? link.dataset.channel
      : /wa\.me|whatsapp/.test(href) ? 'whatsapp'
      : /calendly\.com/.test(href) ? 'calendly'
      : href.indexOf('mailto:') === 0 ? 'email'
      : href.indexOf('tel:') === 0 ? 'phone'
      : null;
    if (channel) {
      gtag('event', 'contact_click', { channel: channel, page_path: location.pathname });
    }
  });

  // El formulario envía a Formspree y sale de la página: beacon para no perder el evento
  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (form.action && form.action.indexOf('formspree.io') !== -1) {
      gtag('event', 'contact_click', { channel: 'form', page_path: location.pathname, transport_type: 'beacon' });
    }
  });
</script>
<script>
  import { reportWebVitals } from '../scripts/web-vitals';
  reportWebVitals();
</script>
  </head>
  <body>
    {/* Degradado de marca para iconos SVG (fill: url(#icon-gradient)); sigue el tema */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="icon-gradient" x1="0" y1="1" x2="1" y2="0">
          <stop offset="0" style="stop-color: var(--gradient-1)" />
          <stop offset="1" style="stop-color: var(--gradient-2)" />
        </linearGradient>
      </defs>
    </svg>
    <Navigation />
    <slot />
    <Footer />
    <ContactMenu />
    <ChatWidget />
  </body>
</html>