---
export const prerender = true;

import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { caseStudies } from '../../data/caseStudies';
import { WHATSAPP_URL } from '../../data/contact';
import meridianoImage from '../../images/project5.avif';
import croplifeImage from '../../images/project16_1.avif';
import miscaImage from '../../images/project19.avif';
import pagoMovilImage from '../../images/project11.avif';
import poligonoAppImage from '../../images/poligono-app.jpg';
import poligonoReservasImage from '../../images/poligono-reservas.jpg';
import poligonoBcvImage from '../../images/poligono-bcv.jpg';
import asistenteImage from '../../images/asistente-ia.jpg';
import asistentePanelImage from '../../images/asistente-ia-panel.jpg';

const images: Record<string, ImageMetadata> = {
  'meridiano-net': meridianoImage,
  croplife: croplifeImage,
  'misca-studio': miscaImage,
  'pago-movil-woocommerce': pagoMovilImage,
  'poligono-club': poligonoAppImage,
  'asistente-ia-darwincd': asistenteImage
};

const extraImages: Record<string, { src: ImageMetadata; alt: string }[]> = {
  'poligono-club': [
    { src: poligonoReservasImage, alt: 'Calendario de reservas en el panel de administración' },
    { src: poligonoBcvImage, alt: 'Configuración de la tasa BCV automática' }
  ],
  'asistente-ia-darwincd': [
    { src: asistentePanelImage, alt: 'El asistente en escritorio, con el botón para enviar el resumen por WhatsApp' }
  ]
};

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug }
  }));
}

const study = caseStudies.find((item) => item.slug === Astro.params.slug);
if (!study) {
  throw new Error('Caso no encontrado');
}

const image = images[study.slug];
const extras = extraImages[study.slug] ?? [];
const isPortrait = image ? image.height > image.width * 0.9 : false;
const siteUrl = 'https://darwincd.com';
const pageUrl = `${siteUrl}/proyectos/${study.slug}/`;

const caseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: study.summary,
  url: pageUrl,
  author: {
    '@type': 'Person',
    name: 'Darwin Cedeño',
    url: siteUrl
  },
  mainEntityOfPage: pageUrl
};
---

<Layout title={`${study.title} | Darwin Cedeño`} description={study.summary}>
  <script type="application/ld+json" set:html={JSON.stringify(caseSchema)} />
  <main class="case-page">
    <div class="container">
      <nav aria-label="Miga de pan">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/proyectos">Proyectos</a></li>
          <li aria-hidden="true">/</li>
          <li>{study.title}</li>
        </ol>
      </nav>

      <h1>{study.title}</h1>
      <p class="summary">{study.summary}</p>
      <p class="service-link">
        <a href={study.serviceHref}>{study.serviceLabel}</a>
      </p>

      {image && (
        <Image
          src={image}
          alt={`Captura del proyecto ${study.title}`}
          width={Math.min(960, image.width)}
          format="avif"
          quality={80}
          class:list={['case-image', { 'case-image-portrait': isPortrait }]}
        />
      )}

      <dl class="case-study">
        <div>
          <dt>Problema</dt>
          <dd>{study.problem}</dd>
        </div>
        <div>
          <dt>Solución</dt>
          <dd>{study.solution}</dd>
        </div>
        <div>
          <dt>Resultado</dt>
          <dd>{study.result}</dd>
        </div>
      </dl>

      {extras.length > 0 && (
        <div class="case-extras">
          {extras.map((extra) => (
            <Image
              src={extra.src}
              alt={extra.alt}
              width={Math.min(960, extra.src.width)}
              format="avif"
              quality={80}
              loading="lazy"
              class="case-image"
            />
          ))}
        </div>
      )}

      <p class="details">{study.details}</p>

      <ul class="tags">
        {study.tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <div class="actions">
        {study.tryAssistant && (
          <button type="button" class="btn-primary btn-try" data-open-chat>Probar el asistente</button>
        )}
        {study.link && (
          <a href={study.link} class="btn-primary" target="_blank" rel="noopener noreferrer">Ver el sitio</a>
        )}
        {study.github && (
          <a href={study.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
        )}
        <a href={WHATSAPP_URL} class="btn-secondary" target="_blank" rel="noopener noreferrer">Hablemos del tuyo por WhatsApp</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .case-page {
    padding: 7rem 0 4rem;
  }

  .container {
    max-width: 46rem;
  }

  nav ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  nav a {
    color: inherit;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--gradient-1);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .summary {
    font-size: 1.15rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .service-link {
    margin-bottom: 1.5rem;
  }

  .service-link a {
    color: var(--gradient-1);
    font-weight: 600;
    text-decoration: none;
  }

  .service-link a:hover {
    text-decoration: underline;
  }

  .case-image {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    margin-bottom: 2rem;
  }

  .case-image-portrait {
    display: block;
    max-width: 26rem;
    margin-left: auto;
    margin-right: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .case-extras {
    margin: 1rem 0 1.5rem;
  }

  .case-study {
    display: grid;
    gap: 1.25rem;
    margin: 0 0 1.5rem;
  }

  .case-study dt {
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gradient-1);
  }

  .case-study dd {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .details {
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    background: var(--secondary-bg);
    font-size: 0.85rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 600;
  }

  .btn-primary {
    background: linear-gradient(90deg, var(--gradient-3), var(--gradient-2), var(--gradient-1));
    color: #f8fafc;
  }

  .btn-try {
    border: none;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-secondary {
    border: 1px solid var(--gradient-1);
    color: inherit;
  }
</style>
