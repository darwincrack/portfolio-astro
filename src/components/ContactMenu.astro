---
import Icon from './Icon.astro';
import { WHATSAPP_URL } from '../data/contact';
---

<a href={WHATSAPP_URL} class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Escríbeme por WhatsApp">
  <Icon name="fab fa-whatsapp" />
  <span class="whatsapp-float-label">Escríbeme</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 56px;
    padding: 0 1.25rem;
    border-radius: 28px;
    background: linear-gradient(45deg, var(--gradient-1), var(--gradient-2));
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .whatsapp-float.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .whatsapp-float:hover {
    color: #fff;
    transform: scale(1.05);
  }

  .whatsapp-float :global(i) {
    font-size: 1.6rem;
  }

  @media (max-width: 768px) {
    .whatsapp-float {
      width: 56px;
      padding: 0;
      justify-content: center;
    }

    .whatsapp-float-label {
      display: none;
    }
  }
</style>

<script>
  function initWhatsappFloat() {
    const button = document.querySelector('.whatsapp-float');
    if (!button) return;

    // En la portada aparece al pasar el botón del hero; en el resto de páginas, siempre
    const heroButton = document.querySelector('.hero-section .contact-btn');
    if (!heroButton) {
      button.classList.add('visible');
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        button.classList.toggle('visible', !entry.isIntersecting);
      });
    }, { threshold: 0, rootMargin: '-50px 0px 0px 0px' });
    observer.observe(heroButton);
  }

  document.addEventListener('DOMContentLoaded', initWhatsappFloat);
  document.addEventListener('astro:page-load', initWhatsappFloat);
</script>
