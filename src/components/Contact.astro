---
import { Image } from 'astro:assets';
import { WHATSAPP_URL } from '../data/contact';
import caracasImage from '../images/caracas-avila.jpg';

const services = [
  "Página web",
  "Sistema o aplicación web a medida",
  "Aplicación móvil",
  "Tienda online",
  "WordPress o plugin a medida",
  "Mejorar la velocidad de mi web",
  "Mantenimiento",
  "Otro / no estoy seguro"
];

const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '6Lf22YkqAAAAAI3bpWLQB0_UYS3HWEHQ5THo1ZjC';
const CALENDLY_URL = import.meta.env.PUBLIC_CALENDLY_URL || 'https://calendly.com/darwinc-dev/consulta-15-min';
---

<section id="contact-section" class="contact-section">
  <Image
    src={caracasImage}
    alt=""
    class="contact-bg"
    widths={[800, 1400, 2000]}
    sizes="100vw"
    format="avif"
    quality={60}
    loading="lazy"
    decoding="async"
  />
  <div class="contact-overlay" aria-hidden="true"></div>

  <div class="container contact-inner">
    <div class="row g-5 align-items-center">
      <div class="col-lg-5 contact-info">
        <h2>¿Me cuentas qué necesitas?</h2>
        <p class="contact-lead">
          Cuéntame tu idea o tu problema, aunque no lo tengas todo definido. Te respondo en menos de 24 horas.
        </p>

        <p class="contact-label">Teléfono y WhatsApp</p>
        <div class="contact-row">
          <a href="tel:+584125447114" class="contact-value">+58 412 544 7114</a>
          <a href={WHATSAPP_URL} class="contact-pill" target="_blank" rel="noopener noreferrer">
            <i class="fab fa-whatsapp" aria-hidden="true"></i> Escribir por WhatsApp
          </a>
        </div>

        <p class="contact-label">Correo</p>
        <a href="mailto:contacto@darwincd.com" class="contact-value">contacto@darwincd.com</a>

        <p class="contact-label">Horario</p>
        <p class="contact-hours">Lunes a viernes, 9:00 a 18:00 (GMT-4)</p>

        {CALENDLY_URL && (
          <a href={CALENDLY_URL} class="contact-calendly" target="_blank" rel="noopener noreferrer">
            ¿Prefieres una llamada? Agenda 15 minutos <span aria-hidden="true">→</span>
          </a>
        )}
      </div>

      <div class="col-lg-7">
        <div class="form-card">
          <form action="https://formspree.io/f/xrbgaarw"
                method="POST"
                class="contact-form"
                accept="application/json">
            <div class="row g-3">
              <div class="col-sm-6">
                <label for="name" class="form-label">Nombre</label>
                <input type="text" class="form-control" id="name" name="nombre" autocomplete="name" required>
              </div>
              <div class="col-sm-6">
                <label for="whatsapp" class="form-label">WhatsApp <span class="optional">(opcional)</span></label>
                <input type="tel" class="form-control" id="whatsapp" name="whatsapp" autocomplete="tel">
              </div>
              <div class="col-12">
                <label for="email" class="form-label">Correo</label>
                <input type="email" class="form-control" id="email" name="email" autocomplete="email" required>
              </div>
              <div class="col-12">
                <label for="service" class="form-label">¿Qué necesitas?</label>
                <select class="form-select" id="service" name="servicio" required>
                  <option value="" disabled selected>Elige una opción</option>
                  {services.map((service) => (
                    <option value={service}>{service}</option>
                  ))}
                </select>
              </div>
              <div class="col-12">
                <label for="message" class="form-label">Mensaje</label>
                <textarea class="form-control" id="message" name="message" rows="4" required></textarea>
              </div>
              <div class="col-12">
                <div class="g-recaptcha"
                     data-sitekey={RECAPTCHA_SITE_KEY}
                     data-callback="onRecaptchaSuccess"
                     data-expired-callback="onRecaptchaExpired">
                </div>
              </div>
            </div>

            <div class="form-footer">
              <p class="form-note">Uso estos datos solo para responder tu consulta.</p>
              <button type="submit" class="form-submit" disabled>
                Enviar mensaje <span aria-hidden="true">→</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <p class="photo-credit">
    Foto: <a href="https://unsplash.com/photos/a-view-of-a-city-with-mountains-in-the-background-BIvkvLqOVEI" target="_blank" rel="noopener noreferrer">Bona Lee / Unsplash</a>
  </p>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
    padding: 6rem 0;
    color: #f8fafc;
    background-color: #0f172a;
    scroll-margin-top: 30px;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .contact-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.78) 45%, rgba(15, 23, 42, 0.55) 100%);
  }

  .contact-inner {
    position: relative;
    z-index: 2;
  }

  .contact-info h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: #f8fafc;
  }

  .contact-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .contact-label {
    margin: 1.25rem 0 0.25rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .contact-value {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
    text-decoration: none;
  }

  .contact-value:hover {
    color: #7dd3fc;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #f8fafc;
    text-decoration: none;
    background: rgba(248, 250, 252, 0.14);
    border: 1px solid rgba(248, 250, 252, 0.2);
    transition: background 0.2s ease;
  }

  .contact-pill:hover {
    color: #f8fafc;
    background: rgba(248, 250, 252, 0.24);
  }

  .contact-hours {
    margin: 0;
  }

  .contact-calendly {
    display: inline-block;
    margin-top: 2rem;
    color: #7dd3fc;
    font-weight: 600;
    text-decoration: none;
  }

  .contact-calendly:hover {
    text-decoration: underline;
  }

  .form-card {
    background: #ffffff;
    color: #0f172a;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
  }

  .form-card .form-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f172a;
  }

  .form-card .optional {
    font-weight: 400;
    color: #64748b;
  }

  .form-card .form-control,
  .form-card .form-select {
    background-color: #ffffff !important;
    color: #0f172a !important;
    border: 1px solid #dbe3ee;
    border-radius: 0.75rem;
    padding: 0.7rem 0.9rem;
  }

  .form-card .form-control:focus,
  .form-card .form-select:focus {
    border-color: var(--gradient-1);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.18);
  }

  .form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .form-note {
    margin: 0;
    max-width: 16rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .form-submit {
    padding: 0.8rem 1.6rem;
    border: none;
    border-radius: 2rem;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(90deg, var(--gradient-3), var(--gradient-2), var(--gradient-1));
    transition: box-shadow 0.2s ease, opacity 0.2s ease;
  }

  .form-submit:hover:not(:disabled) {
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.35);
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .photo-credit {
    position: absolute;
    right: 1rem;
    bottom: 0.5rem;
    z-index: 2;
    margin: 0;
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .photo-credit a {
    color: inherit;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 4rem 0;
    }

    .form-card {
      padding: 1.5rem;
    }

    .contact-overlay {
      background: rgba(15, 23, 42, 0.85);
    }
  }
</style>

<script>
  // Cargar reCAPTCHA solo cuando la sección de contacto se acerca a la pantalla
  function loadRecaptchaScript() {
    if (typeof window.grecaptcha === 'undefined' && !document.querySelector('script[src*="recaptcha"]')) {
      const script = document.createElement('script');
      script.src = 'https://www.google.com/recaptcha/api.js';
      script.async = true;
      script.defer = true;
      document.body.appendChild(script);
    }
  }

  function initRecaptchaObserver() {
    const contactSection = document.querySelector('#contact-section');
    if (!contactSection) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          loadRecaptchaScript();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '50px' });

    observer.observe(contactSection);
  }

  window.onRecaptchaSuccess = function() {
    const submitButton = document.querySelector('.contact-form button[type="submit"]');
    if (submitButton) submitButton.disabled = false;
  };

  window.onRecaptchaExpired = function() {
    const submitButton = document.querySelector('.contact-form button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
  };

  // Registrar el envío del formulario como conversión en Google Analytics
  function initLeadTracking() {
    const form = document.querySelector('.contact-form') as HTMLFormElement | null;
    form?.addEventListener('submit', () => {
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', {
          method: 'formulario',
          service: new FormData(form).get('servicio'),
          transport_type: 'beacon'
        });
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initRecaptchaObserver();
    initLeadTracking();
  });
</script>
