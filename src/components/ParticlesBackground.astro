---
interface Props {
  id?: string;
  fill?: boolean;
}

const { id = 'tsparticles', fill = false } = Astro.props;
---

<div class:list={['particles-container', { 'particles-fill': fill }]}>
  <div id={id} class="particles-canvas"></div>
</div>

<style>
  .particles-container {
    position: absolute;
    width: 100%;
    height: 100vh; /* Limitar al alto de la ventana */
    top: 0;
    left: 0;
    overflow: hidden; /* Importante: evita que las partículas se desborden */
  }

  .particles-fill {
    height: 100%;
  }

  .particles-canvas {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 1;
    pointer-events: none; /* Permite que los clicks pasen a través de las partículas */
  }
</style>

<script>
  // La librería (~140 KB) se descarga solo en pantallas grandes y cuando el
  // navegador está libre: en el celular el fondo queda liso.
  type Engine = typeof import("tsparticles-engine").tsParticles;
  let tsParticles: Engine | undefined;

  const wantsParticles = () =>
    window.matchMedia("(min-width: 769px)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const initParticles = async () => {
    if (!wantsParticles()) return;
    try {
      const [engine, { loadSlim }] = await Promise.all([
        import("tsparticles-engine"),
        import("tsparticles-slim"),
      ]);
      tsParticles = engine.tsParticles;
      await loadSlim(tsParticles);
      
      // Destruir instancias anteriores si existen
      const existingInstances = tsParticles.dom();
      existingInstances.forEach(instance => instance.destroy());
      
      const isSmallScreen = window.matchMedia('(max-width: 768px)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.particles-canvas');

      for (const target of targets) {
      await tsParticles.load(target.id, {
        particles: {
          number: {
            value: isSmallScreen ? 25 : 50,
            density: {
              enable: true,
              value_area: 1000
            }
          },
          color: {
            value: "#d1fae5"
          },
          shape: {
            type: "circle"
          },
          opacity: {
            value: 0.3,
            random: false,
            animation: {
              enable: false
            }
          },
          size: {
            value: 2,
            random: true,
            animation: {
              enable: false
            }
          },
          links: {
            enable: true,
            distance: 200,
            color: "#d1fae5",
            opacity: 0.2,
            width: 1
          },
          move: {
            enable: !reduceMotion,
            speed: 1,
            direction: "none",
            random: false,
            straight: false,
            outModes: {
              default: "out"
            },
            attract: {
              enable: true,
              rotateX: 600,
              rotateY: 1200
            }
          }
        },
        interactivity: {
          detectsOn: "window",
          events: {
            onHover: {
              enable: true,
              mode: "grab"
            },
            onClick: {
              enable: true,
              mode: "push"
            },
            resize: true
          },
          modes: {
            grab: {
              distance: 200,
              links: {
                opacity: 0.3
              }
            },
            push: {
              quantity: 2
            }
          }
        },
        detectRetina: true,
        background: {
          color: "transparent"
        },
        fullScreen: {
          enable: false // Importante: deshabilitar el modo pantalla completa
        }
      });
      }
    } catch (error) {
      console.error('Error initializing particles:', error);
    }
  };

  // Limpiar instancias anteriores antes de reinicializar
  const cleanupParticles = () => {
    if (!tsParticles) return;
    const instances = tsParticles.dom();
    instances.forEach(instance => instance.destroy());
  };

  // Inicializar partículas después de que la página esté lista (no bloquear LCP)
  const scheduleParticles = () => {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => initParticles(), { timeout: 2000 });
    } else {
      window.addEventListener('load', () => setTimeout(initParticles, 0));
    }
  };

  document.addEventListener('astro:before-swap', cleanupParticles);
  document.addEventListener('astro:after-swap', scheduleParticles);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleParticles);
  } else {
    scheduleParticles();
  }
</script> 